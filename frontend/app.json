{
  "expo": {
    "name": "SSK Matrimonial",
    "slug": "ssk-matrimonial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ssk.matrimonial",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SSK Matrimonial needs access to your photo library to upload profile photos.",
        "NSCameraUsageDescription": "SSK Matrimonial needs access to your camera to take profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ssk.matrimonial",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SSK Matrimonial needs access to your photo library to upload profile photos.",
          "cameraPermission": "SSK Matrimonial needs access to your camera to take profile photos."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ssk.matrimonial",
          "enableGooglePay": false
        }
      ]
    ]
  }
}
