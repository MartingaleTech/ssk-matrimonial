DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ssk_matrimonial
# Enable TLS to PostgreSQL (required in production)
DB_SSL=false
# Set to false only when using a self-signed server certificate
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM-encoded CA certificate used to verify the server certificate
DB_SSL_CA=
# Run pending TypeORM migrations on app start (default true). Set to false when
# migrations are applied as a separate deploy step (npm run migration:run:prod).
DB_RUN_MIGRATIONS=true

# Required in production; the app refuses to boot without it
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# AES-256-GCM key for field-level encryption: 64 hex chars or 32 base64 bytes
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Comma-separated list of allowed origins; '*' is rejected in production
CORS_ORIGIN=*
PORT=3000
NODE_ENV=development

# Twilio Verify (used for phone/email OTP delivery)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Verify Service SID (starts with VA...), NOT the Messaging Service SID
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Stripe (United States: cards, Apple Pay, ACH)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (India: UPI, netbanking, cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 object storage for profile photos (all required; the app refuses to boot without them)
# Account ID from the Cloudflare dashboard (R2 > Overview)
R2_ACCOUNT_ID=
# R2 API token credentials (R2 > Manage R2 API Tokens, "Object Read & Write" on the bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ssk-profile-photos
# Custom domain (or r2.dev URL) connected to the bucket; used to serve public photos
R2_PUBLIC_BASE_URL=https://photos.example.com
